#!/usr/bin/env node
/**
 * Stub `claude` CLI for e2e testing — emits stream-json NDJSON like the real
 * CLI's `-p --output-format stream-json`, with zero API calls.
 * A prompt containing "E2E_LONG" makes it stream one line then run until killed
 * (exercises the stop path); "E2E_RECONNECT" emits BEFORE/DURING/AFTER markers
 * gated by files under $CONDUIT_DATA_DIR/reconnect-gates; "E2E_GIT_PUSH:<branch>"
 * commits a file on <branch> in the checkout and pushes it to origin (proves the
 * run's injected git credentials work); anything else completes immediately.
 */
const fs = require('node:fs')
const path = require('node:path')
const { execFileSync } = require('node:child_process')

let prompt = ''
process.stdin.setEncoding('utf8')
process.stdin.on('data', (c) => (prompt += c))
process.stdin.on('end', () => {
  const say = (text) =>
    console.log(
      JSON.stringify({ type: 'assistant', message: { role: 'assistant', content: [{ type: 'text', text }] } })
    )
  say(`stub-claude received prompt: ${prompt.trim().slice(0, 80)}`)
  if (prompt.includes('E2E_FAIL')) {
    console.log(JSON.stringify({ type: 'result', subtype: 'error', result: 'stub-claude failed as requested' }))
    process.exit(1)
  }
  if (prompt.includes('E2E_RECONNECT')) {
    void runReconnect(say)
    return
  }
  const push = /E2E_GIT_PUSH:(\S+)/.exec(prompt)
  if (push) {
    runGitPush(say, push[1])
    return
  }
  if (prompt.includes('E2E_LONG')) {
    const timer = setInterval(() => say('still working…'), 2000)
    process.on('SIGTERM', () => {
      clearInterval(timer)
      process.exit(143)
    })
    return
  }
  console.log(JSON.stringify({ type: 'result', subtype: 'success', result: 'done' }))
  process.exit(0)
})

function runGitPush(say, branch) {
  const git = (...args) => execFileSync('git', args, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] }).trim()
  say(`CRED_ENV GITLAB_TOKEN=${process.env.GITLAB_TOKEN ? 'set' : 'unset'} GITLAB_HOST=${process.env.GITLAB_HOST ?? 'unset'} GH_TOKEN=${process.env.GH_TOKEN ? 'set' : 'unset'} GIT_SSH_COMMAND=${process.env.GIT_SSH_COMMAND ? 'set' : 'unset'}`)
  try {
    git('checkout', '-b', branch)
    fs.writeFileSync(path.join(process.cwd(), `${branch}.txt`), `pushed by stub-claude at ${new Date().toISOString()}\n`)
    git('add', '.')
    git('commit', '-m', `stub-claude commit on ${branch}`)
    git('push', 'origin', `HEAD:refs/heads/${branch}`)
    say(`PUSHED ${branch} ${git('rev-parse', 'HEAD')}`)
    console.log(JSON.stringify({ type: 'result', subtype: 'success', result: 'pushed' }))
    process.exit(0)
  } catch (err) {
    say(`PUSH_FAILED ${String(err.stderr || err.message).replace(/:\/\/[^@\s]+@/g, '://***@')}`)
    console.log(JSON.stringify({ type: 'result', subtype: 'error', result: 'push failed' }))
    process.exit(1)
  }
}

function gatePath(name) {
  const root = process.env.CONDUIT_DATA_DIR?.trim() || process.cwd()
  return path.join(root, 'reconnect-gates', name)
}

function waitForGate(name, timeoutMs = 60_000) {
  const file = gatePath(name)
  return new Promise((resolve, reject) => {
    if (fs.existsSync(file)) return resolve()
    const timer = setTimeout(() => {
      clearInterval(poll)
      reject(new Error(`timed out waiting for reconnect gate ${name}`))
    }, timeoutMs)
    const poll = setInterval(() => {
      if (fs.existsSync(file)) {
        clearTimeout(timer)
        clearInterval(poll)
        resolve()
      }
    }, 50)
  })
}

async function runReconnect(say) {
  say('RECONNECT_BEFORE')
  await waitForGate('during')
  say('RECONNECT_DURING')
  await waitForGate('after')
  say('RECONNECT_AFTER')
  console.log(JSON.stringify({ type: 'result', subtype: 'success', result: 'done' }))
  process.exit(0)
}
